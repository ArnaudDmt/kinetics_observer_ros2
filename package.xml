<?xml version="1.0"?>
<package format="3">
  <name>kinetics_observer_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 wrapper for state-observation KineticsObserver.</description>
  <maintainer email="arnaud.demont@aist.go.jp">Arnaud Demont</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>state-observation</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
